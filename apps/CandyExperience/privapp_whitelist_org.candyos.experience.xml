<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <privapp-permissions package="org.candyos.experience">
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
        <!-- Navigation mode switching (P39.1): the navbar mode overlays. -->
        <permission name="android.permission.CHANGE_OVERLAY_PACKAGES" />
        <!-- Release updater: lets the daily PackageInstaller session commit
             without user action (see docs/updater.md). -->
        <permission name="android.permission.INSTALL_PACKAGES" />
    </privapp-permissions>
</permissions>