// KitKat UI Project: CandyLauncher, the Flutter launcher (package
// com.example.thelauncher), vendored as a prebuilt signed APK.
//
// Registers under the Launcher3QuickStep name because
// vendor/lineage/config/common_mobile.mk adds that module to
// PRODUCT_PACKAGES for non-Go products, so the prebuilt drops into the
// same slot the stock Launcher3 port occupied (los-24 replaced Trebuchet
// with Launcher3; the module name follows it) with zero product-config
// changes - the stock packages/apps/Launcher3 project is removed from the
// manifest by manifest/candyos.xml.
//
// Installed non-privileged on purpose: the APK requests privileged
// permissions (DUMP etc.) but ships no privapp-permissions whitelist, and
// vendor/lineage fails the build on any privileged permission a priv-app
// requests that no whitelist grants. As a regular system_ext app those
// permissions simply don't get granted.
//
// Recents stays SystemUI-side (see TASKS.md, Phase 5): no overview or gesture
// integration here either, so dropping the KitKat Launcher3 port loses
// nothing but its in-tree sources.
android_app_import {
    name: "Launcher3QuickStep",

    apk: "CandyLauncher.apk",
    presigned: true,
    // targetSdk >= 30 requires v2 signing; preprocessed keeps the build
    // system from reprocessing (and thereby wrecking) the signature. The
    // APK ships already zipaligned.
    preprocessed: true,

    system_ext_specific: true,

    // The APK manifest declares androidx.window.extensions/sidecar as
    // optional <uses-library> tags (the window-manager Jetpack interfaces,
    // defined in frameworks/base/libs/WindowManager/Jetpack). The import
    // must declare the same set or manifest_check fails the build on the
    // build-system/manifest mismatch.
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],

    overrides: [
        "Home",
        "Launcher2",
        "Launcher3",
        "QuickSearchBox",
    ],
}

// KitKat UI Project: Launcher3 provides the TAPL (Test Automation
// Programming Library) module that platform_testing (flicker,
// launcher-helper) links against. CandyLauncher is a prebuilt and has no
// TAPL sources, but the module name must exist for soong dependency
// resolution. The test consumers are not part of the system image, so an
// empty library is sufficient.
android_library {
    name: "launcher-aosp-tapl",
    srcs: [],
    resource_dirs: [],
    sdk_version: "current",
}

// KitKat UI Project: Launcher3 also provides its aconfig flag library
// (com_android_launcher3_flags_lib), which frameworks/base
// (services/core, WindowManager/Shell, iconloaderlib) links wholesale.
// No CandyOS-tree production code references the flag classes, so an
// empty library satisfies soong dependency resolution the same way as
// the TAPL stub above.
java_library {
    name: "com_android_launcher3_flags_lib",
    srcs: [],
    sdk_version: "current",
}
