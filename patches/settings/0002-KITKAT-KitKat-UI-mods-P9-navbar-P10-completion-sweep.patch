From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ethan Hill <ethan.hill1999@outlook.com>
Date: Wed, 21 Oct 2026 15:59:11 -0500
Subject: [PATCH 2/5] KITKAT: KitKat UI mods - P9 navbar, P10 completion sweep
 (framework theme/fonts, SystemUI shade/QS/recents/ticker/navbar, Settings
 icons, hybrid 2013 emoji font, easter egg)

---
 res/values/styles.xml |  5 +++++
 res/values/themes.xml | 30 +++++++++++++++++-------------
 2 files changed, 22 insertions(+), 13 deletions(-)

diff --git a/res/values/styles.xml b/res/values/styles.xml
index 4f105e95bec..4e3b551866a 100644
--- a/res/values/styles.xml
+++ b/res/values/styles.xml
@@ -915,6 +915,11 @@
         <item name="android:gravity">start</item>
     </style>
 
+    <!-- KitKat UI Project (11.6): lineage-24 removed the CollapsingToolbar
+         homepage header and its CollapsingToolbarTitle style family, so the
+         former HomepageTitleText override (compact 20sp 4.4 title) has no
+         parent or consumer left - dropped in the los-24 port. -->
+
     <style name="RequestManageCredentialsButtonPanel">
         <item name="android:paddingStart">12dp</item>
         <item name="android:paddingEnd">12dp</item>
diff --git a/res/values/themes.xml b/res/values/themes.xml
index 7422dbc2572..0b6bef447f7 100644
--- a/res/values/themes.xml
+++ b/res/values/themes.xml
@@ -66,7 +66,7 @@
 
         <!-- For AppBarLayout -->
         <item name="colorPrimary">@*android:color/primary_device_default_settings_light</item>
-        <item name="colorPrimaryVariant">@android:color/white</item>
+        <item name="colorPrimaryVariant">@*android:color/primary_dark_device_default_settings</item>
 
         <!-- For slice view in settings -->
         <item name="sliceViewStyle">@style/Widget.SliceView.Settings</item>
@@ -94,8 +94,11 @@
         <!-- Redefine the ActionBar style for contentInsetStart -->
         <item name="android:actionBarStyle">@style/Widget.ActionBar.SubSettings</item>
 
-        <item name="android:navigationBarColor">@android:color/transparent</item>
-        <item name="android:statusBarColor">@android:color/transparent</item>
+        <!-- KitKat UI Project (11.6): 4.4 subpage bars are solid black
+             (transparent bars are an edge-to-edge-era look; with the P2
+             OPAQUE bar default these must be pinned black). -->
+        <item name="android:navigationBarColor">@android:color/black</item>
+        <item name="android:statusBarColor">@android:color/black</item>
     </style>
 
     <style name="Theme.SubSettings" parent="Theme.SubSettings.Base"/>
@@ -185,8 +188,10 @@
     </style>
 
     <style name="Theme.Settings.HomeBase" parent="Theme.Settings.NoActionBar">
-        <item name="colorPrimary">@*android:color/primary_device_default_settings_light</item>
-        <item name="colorAccent">@*android:color/accent_device_default_light</item>
+        <!-- KitKat UI Project (11.6): homepage palette forced to the
+             DeviceDefault DARK pins (4.4 Settings was dark). -->
+        <item name="colorPrimary">@*android:color/primary_dark_device_default_settings</item>
+        <item name="colorAccent">@*android:color/accent_device_default_dark</item>
         <item name="android:listPreferredItemPaddingStart">16dp</item>
         <item name="preferenceTheme">@style/SettingsPreferenceTheme</item>
 
@@ -194,17 +199,16 @@
         <item name="android:actionBarTheme">@*android:style/ThemeOverlay.DeviceDefault.ActionBar</item>
 
         <!-- Define this color for material design -->
-        <item name="colorPrimaryVariant">@android:color/white</item>
+        <item name="colorPrimaryVariant">@*android:color/primary_dark_device_default_settings</item>
     </style>
 
     <style name="Theme.Settings.Home" parent="Theme.Settings.HomeBase">
-        <item name="colorPrimaryDark">@*android:color/primary_dark_device_default_settings_light</item>
-        <item name="android:windowLightStatusBar">true</item>
-        <item name="android:navigationBarDividerColor">@*android:color/ripple_material_light</item>
-        <!-- Homepage should follow device default design, the values is same as device default theme.-->
-        <item name="android:navigationBarColor">@android:color/white</item>
-        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
-        <item name="android:colorBackground">@color/settingslib_materialColorSurfaceContainerLow</item>
+        <!-- KitKat UI Project (11.6): 4.4 Settings homepage - dark bars,
+             dark status bar (no light status bar flag), no nav divider. -->
+        <item name="colorPrimaryDark">@*android:color/primary_dark_device_default_settings</item>
+        <item name="android:windowLightStatusBar">false</item>
+        <item name="android:navigationBarColor">@android:color/black</item>
+        <item name="android:statusBarColor">@android:color/black</item>
     </style>
 
     <style name="Theme.Settings.Home.NoAnimation">
-- 
2.53.0

