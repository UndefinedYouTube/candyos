From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ethan Hill <ethan.hill1999@outlook.com>
Date: Sun, 8 Nov 2026 16:17:23 -0600
Subject: [PATCH 10/22] KitKat UI P18: navbar + IME rotation, suppress shade
 footer actions

- P18.4: qs_panel_padding_top 80dp -> 48dp (donor QS panel: brightness
  slider directly under the single 48dp header row)
- P18.3: the donor shade had no settings/history footer row - footer
  buttons hidden (Flow-visible=false; FooterViewBinder keeps the
  click wiring so re-enabling is a one-line flip)

los-24 port note: upstream split the manage/history footer button into
separate settings/history buttons, so the P18.3 hiding flips the two
per-button visibility flows instead of the old manageOrHistoryButton.

Change-Id: Ia1b8c7e2d1f3a4b5c6d7e8f90a1b2c3d4e5f6a7b
---
 packages/SystemUI/res/values/bools.xml         | 10 ++++++++--
 packages/SystemUI/res/values/dimens.xml        |  7 ++++++-
 .../footer/ui/viewmodel/FooterViewModel.kt     | 18 +++++++++++-------
 3 files changed, 25 insertions(+), 10 deletions(-)

diff --git a/packages/SystemUI/res/values/bools.xml b/packages/SystemUI/res/values/bools.xml
index 1f810c14304a..2dfc68bb5276 100644
--- a/packages/SystemUI/res/values/bools.xml
+++ b/packages/SystemUI/res/values/bools.xml
@@ -28,8 +28,14 @@
     <!-- Whether to enable clipping on Notification Views -->
     <bool name="notification_enable_clipping">true</bool>
 
-    <!-- Whether to enable transparent background for notification scrims -->
-    <bool name="notification_scrim_transparent">false</bool>
+    <!-- KitKat UI P18.5: the 4.4 shade panel was OPAQUE - it rode the
+         PanelView height animation at full alpha with the grab handle
+         attached; the modern scrim fade (behind/notifications scrims
+         darkening with expansion) reads as a post-4.4 fade. Pinning this
+         true zeroes the UNLOCKED-state scrim alphas (ScrimController
+         mTransparentScrimBackground path), so the P3 gradient panel is
+         fully opaque through the whole open/drag/fling - donor ride. -->
+    <bool name="notification_scrim_transparent">true</bool>
 
     <!-- Control whether to force apps to give up control over the display of system bars at all
      times regardless of System Ui Flags.
diff --git a/packages/SystemUI/res/values/dimens.xml b/packages/SystemUI/res/values/dimens.xml
index 8bdbac5fc46c..1eb52e45c5cb 100644
--- a/packages/SystemUI/res/values/dimens.xml
+++ b/packages/SystemUI/res/values/dimens.xml
@@ -754,7 +754,12 @@
          is 12sp -->
     <dimen name="qs_tile_text_size">12sp</dimen>
     <dimen name="qs_panel_padding">16dp</dimen>
-    <dimen name="qs_panel_padding_top">80dp</dimen>
+    <!-- KitKat UI P18.4: the 4.4 QS panel had the brightness slider
+         immediately under the 48dp header row. The stock 80dp reserved
+         clearance for the modern big-clock header, which P15.1 removed
+         (qs_header_height is 48dp) - that clearance is the dead gap the
+         user saw between header and slider on the expanded shade. -->
+    <dimen name="qs_panel_padding_top">48dp</dimen>
 
     <!-- Size is in sp because the icon is inlined in text -->
     <dimen name="qs_edit_mode_app_icon">14sp</dimen>
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/viewmodel/FooterViewModel.kt b/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/viewmodel/FooterViewModel.kt
index f0b478e4017b..3629b94f946a 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/viewmodel/FooterViewModel.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/viewmodel/FooterViewModel.kt
@@ -114,8 +114,12 @@ constructor(
                     .toAnimatedValueFlow()
 
     // Settings buttons are not visible when the message is.
-    val settingsButtonVisible: Flow<Boolean> = message.isVisible.map { !it }
-    val historyButtonVisible: Flow<Boolean> = message.isVisible.map { !it }
+    // KitKat UI P18.3: the donor shade had NO settings/history footer row
+    // (clear-all lives in the header X, ShadeHeaderController). Full
+    // donor-fidelity ruling: footer buttons hidden; the binder keeps the
+    // click wiring so re-enabling is a one-line flip.
+    val settingsButtonVisible: Flow<Boolean> = flowOf(false)
+    val historyButtonVisible: Flow<Boolean> = flowOf(false)
 
     val manageOrHistoryButtonClick: Flow<SettingsIntent> by lazy {
         notificationSettingsInteractor.isNotificationHistoryEnabled.map {
@@ -149,11 +153,11 @@ constructor(
         FooterButtonViewModel(
             labelId = manageOrHistoryButtonText,
             accessibilityDescriptionId = manageOrHistoryButtonText,
-            isVisible =
-                // Hide the manage button if the message is visible
-                message.isVisible.map { messageVisible ->
-                    AnimatedValue.NotAnimating(!messageVisible)
-                },
+            // KitKat UI P18.3: the donor shade had NO manage/history footer
+            // button (clear-all lives in the header X, ShadeHeaderController).
+            // Full-donor-fidelity ruling: footer row hidden; the binder keeps
+            // wiring the click/label paths so re-enabling is a one-line flip.
+            isVisible = flowOf(AnimatedValue.NotAnimating(false)),
         )
 
     @AssistedFactory
-- 
2.53.0

