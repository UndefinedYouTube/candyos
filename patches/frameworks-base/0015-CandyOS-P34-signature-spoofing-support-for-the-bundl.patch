From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ethan Hill <ethan.hill1999@outlook.com>
Date: Sun, 8 Nov 2026 16:20:49 -0600
Subject: [PATCH 15/22] CandyOS P34: signature spoofing support for the bundled
 microG

- new hidden android.permission.FAKE_PACKAGE_SIGNATURE permission
  (signature|privileged), granted only through the privapp whitelist
  shipped in vendor/partner_gms/microg
- maySpoofSignature in ComputerEngine: metadata-independent companion to
  the LineageOS MicrogUtils hook - current microG builds carry the
  fake-signature meta-data as a string resource, which package parsing
  drops, so the fixed Google platform signature
  (MicrogUtils.FAKE_SIGNATURE) is applied whenever the package is one of
  the two preloaded microG packages (com.google.android.gms,
  com.android.vending) and holds the permission. Both the deprecated
  signatures and the modern signingInfo are rewritten.

los-24 port note: lineage-24 moved the LineageOS fake-signature constant
into com.android.internal.content.MicrogUtils (FAKE_SIGNATURE); the
ComputerEngine duplicates of the constants are gone, so the spoof uses
that constant directly.

Change-Id: Ie3f405a6b7c8d9e0f1a2b3c4d5e6f70819203102
---
 core/res/AndroidManifest.xml                  |  5 ++
 .../com/android/server/pm/ComputerEngine.java | 68 +++++++++++++++++--
 2 files changed, 68 insertions(+), 5 deletions(-)

diff --git a/core/res/AndroidManifest.xml b/core/res/AndroidManifest.xml
index 721e53088722..16280a80241f 100644
--- a/core/res/AndroidManifest.xml
+++ b/core/res/AndroidManifest.xml
@@ -5473,6 +5473,11 @@
         android:protectionLevel="normal"
         android:permissionFlags="allowedInPrivateComputeCore" />
 
+    <!-- @hide Allows an application to change the package signature as
+         seen by applications. Only allowed to be used by microG. -->
+    <permission android:name="android.permission.FAKE_PACKAGE_SIGNATURE"
+        android:protectionLevel="signature|privileged" />
+
     <!-- @deprecated No longer useful, see
          {@link android.content.pm.PackageManager#addPackageToPreferred}
          for details. -->
diff --git a/services/core/java/com/android/server/pm/ComputerEngine.java b/services/core/java/com/android/server/pm/ComputerEngine.java
index d89a830ed7c6..956f88f17eef 100644
--- a/services/core/java/com/android/server/pm/ComputerEngine.java
+++ b/services/core/java/com/android/server/pm/ComputerEngine.java
@@ -429,6 +429,11 @@ public class ComputerEngine implements Computer {
     private final PackageManagerInternal.ExternalSourcesPolicy mExternalSourcesPolicy;
     private final CrossProfileIntentResolverEngine mCrossProfileIntentResolverEngine;
 
+    // Packages allowed to spoof their signature when they hold the
+    // (whitelisted) android.permission.FAKE_PACKAGE_SIGNATURE permission.
+    private static final String[] MICROG_FAKE_SIGNATURE_PACKAGES =
+            new String[] { "com.google.android.gms", "com.android.vending" };
+
     // PackageManagerService attributes that are primitives are referenced through the
     // pms object directly.  Primitives are the only attributes so referenced.
     protected final PackageManagerService mService;
@@ -1485,6 +1490,46 @@ public class ComputerEngine implements Computer {
         return result;
     }
 
+    /**
+     * CandyOS P34: metadata-independent companion to the LineageOS hook
+     * above. Current microG builds carry the fake-signature meta-data as a
+     * string resource, which package parsing drops (meta-data values must
+     * be inline), so generateFakeSignature() finds nothing; this port of
+     * the CalyxOS approach applies the fixed Google platform signature
+     * (MicrogUtils.FAKE_SIGNATURE) whenever the package is one of the two
+     * preloaded microG packages and holds the FAKE_PACKAGE_SIGNATURE
+     * permission, granted only through the privapp whitelist shipped in
+     * vendor/partner_gms/microg. Unlike the LineageOS hook this also works
+     * on user builds. Both the deprecated signatures and the modern
+     * signingInfo are rewritten, each only when the caller asked for it.
+     */
+    private PackageInfo maySpoofSignature(AndroidPackage p, PackageInfo pi,
+            Set<String> permissions) {
+        try {
+            if (pi == null
+                    || !permissions.contains("android.permission.FAKE_PACKAGE_SIGNATURE")
+                    || (pi.signatures == null && pi.signingInfo == null)) {
+                return pi;
+            }
+            if (DEBUG_PACKAGE_INFO) {
+                Log.v(TAG, "Spoofing signature for " + p.getPackageName());
+            }
+            pi.signatures = new Signature[] {MicrogUtils.FAKE_SIGNATURE};
+            pi.signingInfo = new SigningInfo(
+                    new SigningDetails(
+                            pi.signatures,
+                            SigningDetails.SignatureSchemeVersion.SIGNING_BLOCK_V3,
+                            SigningDetails.toSigningKeys(pi.signatures),
+                            null
+                    )
+            );
+        } catch (Throwable t) {
+            // We should never die because of any failures, this is system code!
+            Log.w("PackageManagerService.FAKE_PACKAGE_SIGNATURE", t);
+        }
+        return pi;
+    }
+
     public final PackageInfo generatePackageInfo(PackageStateInternal ps,
             @PackageManager.PackageInfoFlagsBits long flags, int userId) {
         if (!mUserManager.exists(userId)) return null;
@@ -1517,14 +1562,27 @@ public class ComputerEngine implements Computer {
             final Set<String> installedPermissions = ((flags & PackageManager.GET_PERMISSIONS) == 0
                     || ArrayUtils.isEmpty(p.getPermissions())) ? Collections.emptySet()
                     : mPermissionManager.getInstalledPermissions(ps.getPackageName());
-            // Compute granted permissions only if package has requested permissions
-            final Set<String> grantedPermissions = ((flags & PackageManager.GET_PERMISSIONS) == 0
+            // Compute granted permissions only if package has requested
+            // permissions, or for the packages allowed to spoof their
+            // signature (the permission check needs the granted set)
+            final boolean isSpoofable = ArrayUtils.contains(MICROG_FAKE_SIGNATURE_PACKAGES,
+                    p.getPackageName());
+            final Set<String> grantedPermissions = (((flags & PackageManager.GET_PERMISSIONS) == 0
+                    && !isSpoofable)
                     || ArrayUtils.isEmpty(p.getRequestedPermissions())) ? Collections.emptySet()
                     : mPermissionManager.getGrantedPermissions(ps.getPackageName(), userId);
 
-            PackageInfo packageInfo = PackageInfoUtils.generate(p, gids, flags,
-                    state.getFirstInstallTimeMillis(), ps.getLastUpdateTime(), installedPermissions,
-                    grantedPermissions, state, userId, ps);
+            PackageInfo packageInfo;
+            if (isSpoofable) {
+                packageInfo = maySpoofSignature(p, PackageInfoUtils.generate(p, gids, flags,
+                        state.getFirstInstallTimeMillis(), ps.getLastUpdateTime(),
+                        installedPermissions, grantedPermissions, state, userId, ps),
+                        grantedPermissions);
+            } else {
+                packageInfo = PackageInfoUtils.generate(p, gids, flags,
+                        state.getFirstInstallTimeMillis(), ps.getLastUpdateTime(), installedPermissions,
+                        grantedPermissions, state, userId, ps);
+            }
 
             if (packageInfo == null) {
                 return null;
