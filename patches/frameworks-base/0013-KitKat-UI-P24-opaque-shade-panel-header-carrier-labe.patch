@@ -91,6 +112,17 @@ public class ShadeCarrierTextController extends ViewController<CarrierText> {
     }
 
     private void updateVisibility(int state) {
-        mView.setVisibility(state == StatusBarState.SHADE ? View.VISIBLE : View.GONE);
+        boolean shade = state == StatusBarState.SHADE;
+        if (shade) {
+            // KitKat UI Project (P24): if the first-appearance fade was
