@@ -16,6 +16,7 @@
 
 package com.android.systemui.shade
 
+import android.graphics.Rect
 import android.view.View
 import android.view.ViewGroup
 import android.view.WindowInsets
@@ -88,11 +89,53 @@ constructor(
         mView.findViewById<View>(R.id.shade_bottom_handle)
     }
 
+    // KitKat UI Project (P24): donor 4.4 OPAQUE shade panel background
+    // (status_bar_expanded.xml, kitkat_shade_panel_bg). Unlocked shade
+    // only; the keyguard shade keeps its scrims over the wallpaper.
+    private val kitkatShadePanelBg: View? by lazy {
+        mView.findViewById<View>(R.id.kitkat_shade_panel_bg)
+    }
+
+    // Latest shade expansion fraction, shared by the handle translation
+    // and the P24 panel-background reveal below.
+    private var shadeFraction: Float = 0f
+
+    // KitKat UI Project (P24): the donor PanelView height animation
+    // revealed an OPAQUE panel top-down over the wallpaper - the
+    // background surface grew with the finger, it never faded. Clip the
+    // full-height background to the expansion fraction so the opaque
+    // panel slides open the same way (no per-frame requestLayout, the
+    // view keeps its measured bounds and only the clip rect moves).
+    private fun applyPanelBgClip(bg: View, fraction: Float) {
+        if (fraction >= 0.9999f) {
+            bg.clipBounds = null
+            return
+        }
+        if (bg.width <= 0 || bg.height <= 0) return
+        val revealedHeight = (bg.height * fraction).toInt()
+        bg.clipBounds = if (revealedHeight > 0) {
+            Rect(0, 0, bg.width, revealedHeight)
+        } else {
+            null
+        }
+    }
+
+    private fun updateKitKatShadePanelBg() {
+        val bg = kitkatShadePanelBg ?: return
+        if (statusBarStateController.state != StatusBarState.SHADE || shadeFraction <= 0f) {
+            bg.visibility = View.GONE
+            return
+        }
+        bg.visibility = View.VISIBLE
+        applyPanelBgClip(bg, shadeFraction)
+    }
+
     private val shadeBottomHandleStateListener =
         object : StatusBarStateController.StateListener {
             override fun onStateChanged(newState: Int) {
                 shadeBottomHandle?.visibility =
                 if (newState == StatusBarState.SHADE) View.VISIBLE else View.GONE
+                updateKitKatShadePanelBg()
             }
         }
 
@@ -104,6 +147,8 @@ constructor(
     // grabber), rising to the panel bottom as the shade fully opens.
     private val shadeBottomHandleExpansionListener =
         ShadeExpansionListener { event: ShadeExpansionChangeEvent ->
+            shadeFraction = event.fraction
+            updateKitKatShadePanelBg()
             if (statusBarStateController.state != StatusBarState.SHADE) return@ShadeExpansionListener
             val handle = shadeBottomHandle ?: return@ShadeExpansionListener
             if (event.fraction <= 0f) return@ShadeExpansionListener
