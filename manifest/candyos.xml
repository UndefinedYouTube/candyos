<?xml version="1.0" encoding="UTF-8"?>
<!--
  CandyOS local manifest (installed into .repo/local_manifests/ by
  scripts/candyos-init.sh).

  LineageOS 24 tree, KitKat look-and-feel. The LineageOS source stays stock;
  CandyOS layers its changes on top after every sync:

    * frameworks/base, packages/apps/Settings and
      packages/inputmethods/LatinIME stay as STOCK LineageOS checkouts.
      scripts/candyos-sync.sh replays the ordered git-am series from
      patches/ on top of them.

    * The app slots below are removed from the manifest entirely so the
      stock (and forked) versions never get checked out. scripts/
      candyos-sync.sh fills each slot with the corresponding CandyOS-vendored
      KitKat app from apps/. Module names are intentionally kept identical
      to the stock apps (ExactCalculator, Recorder, DeskClock, Etar) so
      vendor/lineage product config keeps resolving without changes:

      packages/apps/ExactCalculator<- apps/Calculator     (4.4.4_r1 Calculator)
      packages/apps/Recorder       <- apps/SoundRecorder   (4.4.4_r1 SoundRecorder)
      packages/apps/DeskClock      <- apps/DeskClock       (4.4.4_r1 DeskClock)
      packages/apps/Etar           <- apps/Calendar        (4.4.4_r1 Calendar)

      LineageOS 24 replaced the Trebuchet launcher with stock Launcher3
      and the Eleven audio player with Twelve (media3), so the vendored
      CandyLauncher (module Launcher3QuickStep, the name vendor/lineage
      product config expects) and the 4.4.4_r1 Music port (module Twelve)
      take those two slots instead, and the stock projects are removed
      from the manifest below:

      packages/apps/Launcher3      <- apps/CandyLauncher (prebuilt CandyLauncher.apk)
      packages/apps/Twelve         <- apps/Music         (4.4.4_r1 Music)

    * The SetupWizard slot is removed and filled the same way, by the
      CandyOS Experience app (the first-run onboarding and the "about the
      system" drawer app), keeping the LineageSetupWizard module name so
      vendor/lineage product config keeps resolving without changes:

      packages/apps/SetupWizard    <- apps/CandyExperience  (CandyOS Experience)
-->
<manifest>
  <remove-project name="LineageOS/android_packages_apps_ExactCalculator" />
  <remove-project name="LineageOS/android_packages_apps_Recorder" />
  <remove-project name="LineageOS/android_packages_apps_DeskClock" />
  <remove-project name="LineageOS/android_packages_apps_Etar" />
  <remove-project name="LineageOS/android_packages_apps_SetupWizard" />
  <!-- KitKat UI Project (los-24): stock Launcher3/Twelve replaced by the
       vendored CandyLauncher (module Launcher3QuickStep) and the 4.4.4_r1
       Music port (module Twelve) - see the header comment above. -->
  <remove-project name="LineageOS/android_packages_apps_Launcher3" />
  <remove-project name="LineageOS/android_packages_apps_Twelve" />
</manifest>
